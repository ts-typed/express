  },
  "devDependencies": {
    "@ts-typed/compiler": "0.1.35",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "express": "5.1.0",
    "supertest": "^7.1.4",
    "typescript": "5.9.3"
  }
